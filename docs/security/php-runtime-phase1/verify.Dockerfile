ARG STUDY_IMAGE=shishli-php-study:bookworm
FROM ${STUDY_IMAGE} AS runtime-check
RUN php -v && php-fpm -t && test -x /usr/bin/cgi-fcgi && ! command -v gcc && ! command -v git && ! command -v composer
RUN php -r 'foreach (["dom","libxml","openssl","fileinfo","posix","ctype","pdo_mysql","pdo_sqlite","mbstring","intl","zip","gd","bcmath","pcntl","Zend OPcache","redis"] as $e) { if (!extension_loaded($e)) { throw new Exception($e); } } $gd=gd_info(); foreach (["JPEG Support","PNG Support","WebP Support"] as $f) { if (!$gd[$f]) { throw new Exception($f); } } $db=new PDO("sqlite::memory:"); $db->exec("CREATE TABLE probe (id INTEGER)"); $db->exec("INSERT INTO probe VALUES (1)"); if ($db->query("SELECT id FROM probe")->fetchColumn()!=1) { throw new Exception("SQLite"); } new Redis(); $zip=new ZipArchive(); $zip->open("/tmp/check.zip",ZipArchive::CREATE); $zip->addFromString("ar.txt","Arabic zip"); $zip->close(); $zip->open("/tmp/check.zip"); if ($zip->getFromName("ar.txt")!=="Arabic zip") { throw new Exception("zip"); } $zip->close(); unlink("/tmp/check.zip"); echo "PHP_RUNTIME_FACTS ".json_encode(["php"=>PHP_VERSION,"redis"=>phpversion("redis"),"sqlite"=>$db->query("SELECT sqlite_version()")->fetchColumn(),"icu"=>INTL_ICU_VERSION,"gd"=>$gd,"timezone"=>(new DateTimeImmutable("2026-01-15T12:00:00Z"))->setTimezone(new DateTimeZone("Asia/Riyadh"))->format("H:i"),"arabic_month"=>(new IntlDateFormatter("ar_SA",0,0,"Asia/Riyadh",IntlDateFormatter::GREGORIAN,"MMMM"))->format(1768478400)],JSON_UNESCAPED_UNICODE).PHP_EOL;'
RUN php -r '$month=(new IntlDateFormatter("ar_SA",0,0,"Asia/Riyadh",IntlDateFormatter::GREGORIAN,"MMMM"))->format(1768478400); if (!preg_match("/[\x{0600}-\x{06ff}]/u",$month)) { throw new Exception("Missing Arabic ICU locale: ".$month); } $im=imagecreatetruecolor(2,2); foreach (["imagejpeg","imagepng","imagewebp"] as $fn) { ob_start(); $fn($im); $data=ob_get_clean(); if (!strlen($data)) { throw new Exception($fn); } } $pid=pcntl_fork(); if ($pid===0) { exit(23); } pcntl_waitpid($pid,$s); if (!pcntl_wifexited($s)||pcntl_wexitstatus($s)!==23) { throw new Exception("pcntl"); } echo "LOCALE_GD_PCNTL_OK\n";'
RUN APP_ENV=testing CACHE_STORE=array SESSION_DRIVER=array php artisan --version && APP_ENV=testing CACHE_STORE=array SESSION_DRIVER=array php artisan route:list --path=api --except-vendor > /tmp/api-routes.txt && grep -q api/v1 /tmp/api-routes.txt && echo API_ROUTES_OK
RUN set -eu; php-fpm -F & fpm_pid=$!; trap 'kill "$fpm_pid" 2>/dev/null || true' EXIT; for attempt in 1 2 3 4 5; do if SCRIPT_NAME=/fpm-ping SCRIPT_FILENAME=/fpm-ping REQUEST_METHOD=GET cgi-fcgi -bind -connect 127.0.0.1:9000 > /tmp/ping.txt && grep -q pong /tmp/ping.txt; then break; fi; sleep 1; done; grep -q pong /tmp/ping.txt; echo FPM_PING_OK; printf '%s' '<?php echo json_encode(["opcache"=>opcache_get_status()["opcache_enabled"] ?? false]);' > /tmp/opcache.php; SCRIPT_NAME=/opcache.php SCRIPT_FILENAME=/tmp/opcache.php REQUEST_METHOD=GET cgi-fcgi -bind -connect 127.0.0.1:9000 > /tmp/opcache.txt; grep -q '"opcache":true' /tmp/opcache.txt; echo FPM_OPCACHE_OK
RUN php -r '$db=new PDO("sqlite::memory:"); file_put_contents("/tmp/runtime-facts.json",json_encode(["php"=>PHP_VERSION,"redis"=>phpversion("redis"),"sqlite"=>$db->query("SELECT sqlite_version()")->fetchColumn(),"icu"=>INTL_ICU_VERSION,"arabic_month"=>(new IntlDateFormatter("ar_SA",0,0,"Asia/Riyadh",IntlDateFormatter::GREGORIAN,"MMMM"))->format(1768478400),"timezone"=>(new DateTimeImmutable("2026-01-15T12:00:00Z"))->setTimezone(new DateTimeZone("Asia/Riyadh"))->format("H:i")],JSON_PRETTY_PRINT|JSON_UNESCAPED_UNICODE));'
RUN cat /etc/os-release > /tmp/os-release.txt && php -m > /tmp/modules.txt && (ldd /usr/local/bin/php; ldd /usr/local/sbin/php-fpm; find /usr/local/lib/php/extensions -type f -name '*.so' -exec ldd '{}' ';') > /tmp/ldd.txt && ! grep -q 'not found' /tmp/ldd.txt
RUN if command -v dpkg-query > /dev/null; then dpkg-query -W; else apk info -vv; fi > /tmp/packages.txt
RUN php -r 'file_put_contents("/tmp/xml-version.txt", LIBXML_DOTTED_VERSION);'
FROM scratch AS evidence
COPY --from=runtime-check /tmp/runtime-facts.json /runtime-facts.json
COPY --from=runtime-check /tmp/os-release.txt /os-release.txt
COPY --from=runtime-check /tmp/modules.txt /modules.txt
COPY --from=runtime-check /tmp/ldd.txt /ldd.txt
COPY --from=runtime-check /tmp/packages.txt /packages.txt
COPY --from=runtime-check /tmp/xml-version.txt /xml-version.txt
