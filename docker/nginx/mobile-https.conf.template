# Local TLS gateway. All routes, application policy and geocoding quota stay
# in the existing nginx service. No direct PHP/MySQL/Redis connection.
server {
    listen 443 ssl;
    http2 on;
    server_name __LAN_IP__;
    server_tokens off;
    client_max_body_size 24m;
    ssl_certificate /etc/nginx/mobile-tls/server.crt;
    ssl_certificate_key /etc/nginx/mobile-tls/server.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:mobile_tls:1m;
    ssl_session_timeout 10m;
    gzip on;
    gzip_vary on;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;

    location / {
        proxy_pass http://nginx:80;
        proxy_http_version 1.1;
        proxy_set_header Host "__LAN_IP__:__HTTPS_PORT__";
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Port __HTTPS_PORT__;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header Forwarded "";
        proxy_set_header Accept-Encoding "";
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;

        # APP_URL stays on HTTP for the existing site. Rewrite only the two
        # known local origins in HTML/JSON, including JSON-escaped slashes.
        # This avoids changing Laravel, Trusted Proxies, CORS or stored data.
        sub_filter_once off;
        sub_filter_types application/json;
        sub_filter 'http://127.0.0.1:8088' 'https://__LAN_IP__:__HTTPS_PORT__';
        sub_filter 'http:\\/\\/127.0.0.1:8088' 'https:\\/\\/__LAN_IP__:__HTTPS_PORT__';
        sub_filter 'http://__LAN_IP__:__HTTPS_PORT__' 'https://__LAN_IP__:__HTTPS_PORT__';
        sub_filter 'http:\\/\\/__LAN_IP__:__HTTPS_PORT__' 'https:\\/\\/__LAN_IP__:__HTTPS_PORT__';
        proxy_redirect http://127.0.0.1:8088/ https://__LAN_IP__:__HTTPS_PORT__/;
        proxy_redirect http://__LAN_IP__:__HTTPS_PORT__/ https://__LAN_IP__:__HTTPS_PORT__/;
    }
}
