# Template only: supply a real APP_KEY and database password through deployment secrets.
# Never copy the local .env or commit a populated production .env.
APP_NAME=Shishli
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://restaurant.example
APP_LOCALE=ar
APP_FALLBACK_LOCALE=ar
APP_MAINTENANCE_DRIVER=file
BUSINESS_TIMEZONE=Asia/Riyadh
BCRYPT_ROUNDS=12

DB_CONNECTION=mysql
DB_URL=
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=shishli
DB_USERNAME=shishli_app
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# Bearer-token API; stateful Sanctum SPA middleware is not enabled in this project.
SANCTUM_STATEFUL_DOMAINS=
SANCTUM_TOKEN_PREFIX=shishli_
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=null

# Leave origins empty for a same-origin reverse proxy. For a separate frontend,
# list its exact HTTPS origin(s), comma-separated, without trailing slashes.
CORS_ALLOWED_ORIGINS=
# Exact proxy IPs/CIDRs only; leave blank until the deployment topology is known.
# Ensure Laravel is reachable only through those proxies.
TRUSTED_PROXIES=

CACHE_STORE=database
CACHE_LIMITER=database
CACHE_PREFIX=shishli_production_
QUEUE_CONNECTION=database
NOTIFICATION_QUEUE_CONNECTION=database
QUEUE_FAILED_DRIVER=database-uuids
BROADCAST_CONNECTION=log

FILESYSTEM_DISK=local
MEDIA_DISK=public
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null

# External channels stay disabled in config/outbound_notifications.php.
# log is deliberately not a claim of real email delivery.
MAIL_MAILER=log
MAIL_FROM_ADDRESS=orders@restaurant.example
MAIL_FROM_NAME=Shishli

# No real adapter is registered. Keep online payments disabled until integrated.
PAYMENT_DEFAULT_PROVIDER=
PAYMENT_WEBHOOK_MAX_BODY_BYTES=65536
PAYMENT_WEBHOOK_TIMESTAMP_TOLERANCE=300
