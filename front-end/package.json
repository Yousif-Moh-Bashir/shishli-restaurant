{
  "name": "front-end",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev:finance": "vite --config vite.finance.config.js",
    "build:finance": "vite build --config vite.finance.config.js",
    "test:finance": "node --test tests/finance.test.mjs tests/finance-dev.test.mjs tests/finance.repository.test.mjs",
    "test:finance:browser": "node --experimental-websocket tests/finance.browser.mjs",
    "test:finance:live": "node --experimental-websocket tests/finance.live.browser.mjs",
    "test:delivery-exceptions": "node tests/delivery-exceptions.test.mjs",
    "test:delivery-exceptions:browser": "node --experimental-websocket tests/delivery-exceptions.browser.mjs",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test:delivery-location": "node tests/checkout-location.mjs && node tests/location-provider.test.mjs && node tests/delivery-quote-races.test.mjs",
    "test:delivery-location:browser": "node --experimental-websocket tests/delivery-location-ux.browser.mjs"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "leaflet": "^1.9.4",
    "pinia": "^4.0.3",
    "vue": "^3.5.42",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.8",
    "vite": "^8.3.0"
  }
}
