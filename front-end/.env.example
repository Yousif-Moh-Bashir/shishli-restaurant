VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1

# Public browser configuration, not secrets. Use a dedicated provider for production traffic.
VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_MAP_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>
# Nominatim-compatible reverse endpoint; "disabled" keeps map/manual input only.
VITE_GEOCODING_REVERSE_URL=https://nominatim.openstreetmap.org/reverse
